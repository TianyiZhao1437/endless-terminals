Bootstrap: localimage
From: ./ubuntu_22.04.sif

%post
    set -eux

    # Create user and set up home directory
    useradd -m -d /home/user user

    # Create required directories and files
    mkdir -p /home/user/ml_data
    mkdir -p /home/user/models

    # Create the empty training set file
    touch /home/user/ml_data/training_set.csv

    # Set permissions so the user can read/write
    chown -R user:user /home/user
    chmod 700 /home/user
    chmod 700 /home/user/ml_data
    chmod 700 /home/user/models
    chmod 600 /home/user/ml_data/training_set.csv

    # Install Python3, pip, and pytest
    apt-get update
    apt-get install -y python3 python3-pip
    pip3 install --no-cache-dir pytest python-dotenv

%labels
    Author ml-engineer
    Description "Base for ML env var dotenv secure configuration task"

%files

%runscript
    exec /bin/bash