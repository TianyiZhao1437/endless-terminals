Bootstrap: localimage
From: ./ubuntu_22.04.sif

%post
    set -eux

    # Create user and home directory
    useradd -m -s /bin/bash user

    # Create /home/user/uptime_logs with user-write permissions
    mkdir -p /home/user/uptime_logs
    chown user:user /home/user/uptime_logs
    chmod 700 /home/user/uptime_logs

    # Install pip and pytest
    apt-get update
    apt-get install -y python3-pip
    pip3 install --no-cache-dir pytest

%files

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8