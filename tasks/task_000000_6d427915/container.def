Bootstrap: localimage
From: ./ubuntu_22.04.sif

%post
    # Create user directory for task
    mkdir -p /home/user
    chown -R nobody:nogroup /home/user

    # Install sqlite3 and python3-pip
    apt-get update
    apt-get install -y sqlite3 python3-pip

    # Install pytest for testing
    pip3 install pytest

    # Ensure permissions for /home/user are non-root for agent
    chmod 755 /home/user

%files
    # (No files to copy in for initial state)

%environment
    export PATH=/usr/local/bin:/usr/bin:/bin:$PATH

%setup
    # (No setup actions needed)

%labels
    Author pipeline-task
    Description SQLite pipeline tracking initial state for agent testing.