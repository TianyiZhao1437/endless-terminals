Bootstrap: localimage
From: ./ubuntu_22.04.sif

%post
    # Create the project directory with correct permissions
    mkdir -p /home/user/iot-data-collector
    chown nobody:nogroup /home/user/iot-data-collector
    chmod 755 /home/user/iot-data-collector

    # Create VERSION file with initial contents
    echo "1.2.3" > /home/user/iot-data-collector/VERSION
    chown nobody:nogroup /home/user/iot-data-collector/VERSION
    chmod 644 /home/user/iot-data-collector/VERSION

    # Create CHANGELOG.md file with initial contents
    cat > /home/user/iot-data-collector/CHANGELOG.md <<EOF
## [1.2.3] - 2024-05-10

- Fixed bug in sensor data parser.

## [1.2.2] - 2024-04-27

- Improved MQTT reconnect strategy.
EOF
    chown nobody:nogroup /home/user/iot-data-collector/CHANGELOG.md
    chmod 644 /home/user/iot-data-collector/CHANGELOG.md

    # Install pip and pytest
    apt-get update
    apt-get install -y python3-pip
    pip3 install --no-cache-dir pytest

%environment
    export PATH=/usr/local/bin:/usr/bin:/bin:$PATH