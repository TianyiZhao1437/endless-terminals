Bootstrap: localimage
From: ./ubuntu_22.04.sif

%post
    set -e

    # Install dependencies
    apt-get update
    apt-get install -y python3 python3-pip sqlite3
    pip3 install pytest

    # Create user 'user' with home directory /home/user if not already present
    useradd -m -s /bin/bash user

    # Create the /home/user/security_audit directory with correct ownership and permissions
    install -d -m 755 -o user -g user /home/user/security_audit

    # Create the SQLite database with the required table and data as user 'user'
    su - user -c "
        sqlite3 /home/user/security_audit/permissions.db <<'EOF'
CREATE TABLE user_permissions (
    username TEXT,
    role TEXT,
    can_edit INTEGER
);
INSERT INTO user_permissions (username, role, can_edit) VALUES
    ('alice', 'admin', 1),
    ('bob', 'staff', 0),
    ('carol', 'editor', 1),
    ('dave', 'guest', 0);
EOF
    "

    # Ensure permissions.db is owned and writable by 'user'
    chown user:user /home/user/security_audit/permissions.db
    chmod 644 /home/user/security_audit/permissions.db

%labels
    Author="Apptainer Expert"
    Description="Container for SQLite user permissions security audit task."