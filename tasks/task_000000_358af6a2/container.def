Bootstrap: localimage
From: ./ubuntu_22.04.sif

%post
    set -e
    # Create the user directory if it doesn't exist
    mkdir -p /home/user

    # Create the input file with the required contents
    cat > /home/user/api_responses.txt <<EOF
{"id":12,"status":"ok"}
{"status":"error"}
{"id":42,"status":"fail"}
{"id":77,"status":"retry"}
EOF

    # Make sure the file is owned by user and readable/writable
    chmod 644 /home/user/api_responses.txt

    # Ensure the output file does not exist
    rm -f /home/user/extracted_ids.txt

    # Install pip and pytest
    apt-get update
    apt-get install -y python3-pip
    pip3 install pytest

%files

%environment

%labels
    Author="integration-dev-test"
    Description="Container for API response integration task with pytest installed and input file prepared."