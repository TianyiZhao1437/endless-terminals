Bootstrap: localimage
From: ./ubuntu_22.04.sif

%post
    # Create user and home directory if not present
    if ! id user >/dev/null 2>&1; then
        useradd -m -d /home/user user
    fi

    # Ensure 'services' directory exists
    mkdir -p /home/user/services
    chown -R user:user /home/user/services

    # Create the payment_service.ini file with the required content
    cat > /home/user/services/payment_service.ini <<EOF
[general]
service_name = PaymentService
timeout = 30

[database]
host = db.production.internal
port = 5432
user = payments
password = secret

[logging]
level = INFO
EOF

    # Set permissions so user can write/read
    chown user:user /home/user/services/payment_service.ini
    chmod 644 /home/user/services/payment_service.ini

    # Install python3 and pip
    apt-get update
    apt-get install -y python3 python3-pip

    # Install pytest (for testing)
    pip3 install pytest

%environment
    export PATH=/usr/local/bin:$PATH