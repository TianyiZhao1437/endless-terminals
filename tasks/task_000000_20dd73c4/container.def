Bootstrap: localimage
From: ./ubuntu_22.04.sif

%post
    apt-get update
    apt-get install -y python3-pip
    pip3 install pytest

    # Create the required directory structure
    mkdir -p /home/user/mlops/experiments

    # Set permissions so user can write to the experiments directory
    chmod -R 0777 /home/user/mlops/experiments

    # Create artifacts.txt with the specified contents
    cat > /home/user/mlops/experiments/artifacts.txt <<EOF
model
log
model
plot
model
plot
model
log
plot
model
EOF

    # Ensure artifacts.txt is writable by the user
    chmod 0666 /home/user/mlops/experiments/artifacts.txt

%labels
    Author mlops-experiment-prep
    Description "Container with initial experiment artifact data for MLOps task"