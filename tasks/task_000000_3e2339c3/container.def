Bootstrap: localimage
From: ./ubuntu_22.04.sif

%post
    set -e
    # Install Python 3 and venv module
    apt-get update
    apt-get install -y python3 python3-venv python3-pip

    # Create the user and compliance_check directory
    useradd -m user
    mkdir -p /home/user/compliance_check
    chown -R user:user /home/user/compliance_check

    # Install pytest for the user
    pip3 install --no-cache-dir pytest

%files

%environment

%runscript
    exec "$@"