Bootstrap: localimage
From: ./ubuntu_22.04.sif

%post
    set -e

    # Create user and set up home directory
    useradd -m -d /home/user user

    # Create required directories
    mkdir -p /home/user/projects/cleaning/datasets

    # Create the iris.csv file and make it readable
    echo "sepal_length,sepal_width,petal_length,petal_width,species
5.1,3.5,1.4,0.2,setosa
4.9,3.0,1.4,0.2,setosa
6.2,2.8,4.8,1.8,virginica
" > /home/user/projects/cleaning/datasets/iris.csv
    chmod 644 /home/user/projects/cleaning/datasets/iris.csv
    chown -R user:user /home/user/projects

    # Install pip and pytest
    apt-get update
    apt-get install -y python3-pip
    pip3 install --no-cache-dir pytest

%environment
    # No environment variables set here; agent must set DATASET_PATH in session

%runscript
    # Default runscript: start a shell as user
    exec su - user

%labels
    Author agent-task
    Description "Container for environment variable task with pytest installed and required files/directories present."