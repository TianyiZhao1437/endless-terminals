Bootstrap: localimage
From: ./ubuntu_22.04.sif

%post
    set -e

    # Create user and home directory if not present
    if ! id -u user >/dev/null 2>&1; then
        useradd -m -s /bin/bash user
    fi

    # Make sure the test_logs directory exists
    mkdir -p /home/user/test_logs
    chown user:user /home/user/test_logs
    chmod 755 /home/user/test_logs

    # Create the app.log file with the specified content
    cat > /home/user/test_logs/app.log <<EOF
[2024-06-01 12:00:14] [INFO] Service started successfully
[2024-06-01 12:01:22] [ERROR] Failed to connect to database
[2024-06-01 12:02:05] [WARNING] Database retrying connection
[2024-06-01 12:02:10] [ERROR] Unable to open configuration file
[2024-06-01 12:03:45] [INFO] Service is running
EOF

    chown user:user /home/user/test_logs/app.log
    chmod 644 /home/user/test_logs/app.log

    # Ensure error_report.log does not exist
    rm -f /home/user/test_logs/error_report.log

    # Install pip and pytest
    apt-get update
    apt-get install -y python3-pip
    pip3 install --no-cache-dir pytest

%environment
    export PATH=/home/user/.local/bin:$PATH