Bootstrap: localimage
From: ./ubuntu_22.04.sif

%post
    set -e

    # Install Python3, pip, and pytest
    apt-get update
    apt-get install -y python3 python3-pip
    pip3 install --no-cache-dir pytest

    # Create the workspace directory with proper permissions
    mkdir -p /home/user/mlruns/artifacts
    chmod 0775 /home/user/mlruns/artifacts

    # Create trained_model.pt with the specified byte sequence
    python3 -c "with open('/home/user/mlruns/artifacts/trained_model.pt', 'wb') as f: f.write(bytes([0x50, 0x59, 0x54, 0x4f, 0x52, 0x43, 0x48, 0x20, 0x6d, 0x6f, 0x64, 0x65, 0x6c, 0x20, 0x66, 0x69, 0x6c, 0x65]))"

    # Ensure permissions for the agent user (read/write in artifacts dir and file)
    chmod 0664 /home/user/mlruns/artifacts/trained_model.pt

%labels
    Author mlops-task