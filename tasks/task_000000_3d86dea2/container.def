Bootstrap: localimage
From: ./ubuntu_22.04.sif

%post
    set -e

    # Create user home directory and set permissions
    mkdir -p /home/user
    chmod 755 /home/user

    # Install python3 and pip, then install pytest
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y python3 python3-pip
    pip3 install --no-cache-dir pytest

    # Ensure /etc/passwd has exactly the required lines
    cat >/etc/passwd <<'EOF'
root:x:0:0:root:/root:/bin/bash
alice:x:1000:1000:Alice:/home/alice:/bin/bash
bob:x:1001:1001:Bob:/home/bob:/usr/sbin/nologin
eve:x:1002:1002:Eve:/home/eve:/bin/sh
hacker:x:0:0:Hacker:/root:/bin/bash
service:x:1003:1003:Service:/nonexistent:/usr/sbin/nologin
EOF

    # Pad /etc/passwd to exactly 1234 bytes
    actual_size=$(stat -c%s /etc/passwd)
    pad_size=$((1234 - actual_size))
    if [ $pad_size -gt 0 ]; then
        head -c $pad_size </dev/zero >>/etc/passwd
    fi

    # Set permissions, owner, and group for /etc/passwd
    chown root:root /etc/passwd
    chmod 644 /etc/passwd

%files

%environment

%runscript
    exec /bin/bash