Bootstrap: localimage
From: ./ubuntu_22.04.sif

%post
    set -eux

    # Install python3, pip, and pytest
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y python3 python3-pip
    pip3 install --no-cache-dir pytest

    # Create user 'user' with home directory /home/user and group 'user'
    groupadd --gid 1000 user
    useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash user

    # Create the scripts directory
    mkdir -p /home/user/scripts
    chown user:user /home/user/scripts
    chmod 755 /home/user/scripts

    # Create the backup.sh file as user, with world-writable permissions (777)
    su - user -c 'touch /home/user/scripts/backup.sh'
    chmod 777 /home/user/scripts/backup.sh
    chown user:user /home/user/scripts/backup.sh

    # (Don't create permission_log.txt here - agent is supposed to do it!)

%files

%environment

%labels
    Author="Apptainer Expert"
    Description="Container for backup.sh file permissions task with pytest installed."