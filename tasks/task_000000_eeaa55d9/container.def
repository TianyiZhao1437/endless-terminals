Bootstrap: localimage
From: ./ubuntu_22.04.sif

%post
    set -eux

    # Create user (if not already present) and set up home
    if ! id user >/dev/null 2>&1; then
        useradd -m -s /bin/bash user
    fi

    # Install ping (iputils-ping), python3, pip, and pytest
    apt-get update
    apt-get install -y iputils-ping python3 python3-pip
    pip3 install --no-cache-dir pytest

    # Ensure /home/user ownership (if created above)
    chown -R user:user /home/user

%environment
    export PATH="/home/user/.local/bin:$PATH"