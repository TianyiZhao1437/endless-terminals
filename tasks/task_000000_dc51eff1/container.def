Bootstrap: localimage
From: ./ubuntu_22.04.sif

%post
    set -e

    # Install pip and pytest
    apt-get update
    apt-get install -y python3-pip
    pip3 install --no-cache-dir pytest

    # Create user and home directory if not present
    if ! id user >/dev/null 2>&1; then
        useradd -m -d /home/user user
    fi

    # Make sure /home/user/audit_configs exists and has the right permissions
    mkdir -p /home/user/audit_configs
    chown user:user /home/user/audit_configs
    chmod 755 /home/user/audit_configs

    # Create /home/user/audit_configs/server.yaml with exact content
    cat >/home/user/audit_configs/server.yaml <<EOF
---
port: 8080
host: "127.0.0.1"
max_connections: 250
debug: false
EOF

    # Create /home/user/audit_configs/security.toml with exact content
    cat >/home/user/audit_configs/security.toml <<EOF
[settings]
encryption = true
firewall = "enabled"
max_connections = 150
EOF

    # Set permissions so user can write to everything
    chown user:user /home/user/audit_configs/server.yaml
    chown user:user /home/user/audit_configs/security.toml
    chmod 644 /home/user/audit_configs/server.yaml
    chmod 644 /home/user/audit_configs/security.toml

%labels
    Author="Apptainer Compliance Task Preparation"
    Description="Container for compliance audit configuration extraction task with initial state and pytest installed."