Bootstrap: localimage
From: ./ubuntu_22.04.sif

%post
    # Create the 'user' user and group if not already present
    if ! id user >/dev/null 2>&1; then
        groupadd -g 1000 user
        useradd -m -s /bin/bash -u 1000 -g 1000 user
    fi

    # Create /home/user/devtools directory owned by user
    mkdir -p /home/user/devtools
    chown user:user /home/user/devtools

    # Install Python3 and venv module, as well as pip for pytest installation
    apt-get update
    apt-get install -y python3 python3-venv python3-pip

    # Install pytest globally (for testing)
    pip3 install pytest

%environment
    export PATH=/usr/local/bin:/usr/bin:/bin:$PATH

%files