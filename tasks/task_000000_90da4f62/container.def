Bootstrap: localimage
From: ./ubuntu_22.04.sif

%post
    set -eux

    # Create user and home directory
    useradd -m -s /bin/bash user

    # Install required packages: openssl, python3, pip, and networking tools
    apt-get update
    apt-get install -y --no-install-recommends \
        openssl \
        python3 \
        python3-pip \
        iputils-ping \
        netcat-openbsd \
        ca-certificates

    # Install pytest for test running
    pip3 install --no-cache-dir pytest

    # Ensure permissions for /home/user
    chown -R user:user /home/user

%files

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%runscript
    exec /bin/bash