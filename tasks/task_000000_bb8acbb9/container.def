Bootstrap: localimage
From: ./ubuntu_22.04.sif

%post
    # Create the user and home directory
    useradd -m user

    # Create the uptime_logs directory with correct permissions
    mkdir -p /home/user/uptime_logs
    chown user:user /home/user/uptime_logs
    chmod 755 /home/user
    chmod 755 /home/user/uptime_logs

    # Create the ping_results.txt file with the specified content
    cat > /home/user/uptime_logs/ping_results.txt <<EOF
2024-06-11 10:00:00 UP
2024-06-11 10:01:00 UP
2024-06-11 10:02:00 UP
2024-06-11 10:03:00 DOWN
2024-06-11 10:04:00 UP
2024-06-11 10:05:00 DOWN
2024-06-11 10:06:00 UP
2024-06-11 10:07:00 UP
2024-06-11 10:08:00 UP
2024-06-11 10:09:00 UP
EOF

    chown user:user /home/user/uptime_logs/ping_results.txt
    chmod 644 /home/user/uptime_logs/ping_results.txt

    # Install pip and pytest
    apt-get update
    apt-get install -y python3-pip
    pip3 install pytest

%labels
    Maintainer example@example.com