Bootstrap: localimage
From: ./ubuntu_22.04.sif

%post
    set -e

    # Install Python3 and pip
    apt-get update
    apt-get install -y python3 python3-pip

    # Install pytest
    pip3 install --no-cache-dir pytest

    # Create user directory structure
    mkdir -p /home/user/project/artifacts

    # Create the artifact files
    touch /home/user/project/artifacts/build1.zip
    touch /home/user/project/artifacts/build2.zip
    touch /home/user/project/artifacts/report.txt
    touch /home/user/project/artifacts/notes.md
    touch /home/user/project/artifacts/test.zip
    touch /home/user/project/artifacts/archive.tar.gz

    # Ensure permissions are user-writable (agent will not have root)
    chown -R root:root /home/user
    chmod -R u+rwX,go+rX /home/user

    # Do NOT create /home/user/project/archived_zips
    # Do NOT create /home/user/project/zip_move.log

%labels
    Author="Apptainer Task Setup"
    Description="Environment with /home/user/project/artifacts containing .zip and other files, ready for ZIP file archival task."