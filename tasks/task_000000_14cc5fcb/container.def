Bootstrap: localimage
From: ./ubuntu_22.04.sif

%post
# Create user and home directory if not present
if ! id user >/dev/null 2>&1; then
    useradd -m -d /home/user user
fi

# Install Python3, pip, and curl
apt-get update
apt-get install -y python3 python3-pip curl

# Install pytest (for agent testing)
pip3 install --no-cache-dir pytest

# Ensure user has ownership of their home directory
chown -R user:user /home/user

%environment
    chmod 755 /home/user

# Set PATH for Python3 and curl
export PATH=/usr/bin:$PATH

%runscript
# This container is ready for agent testing.
echo "Container ready for agent task. Python3, curl, and pytest are installed."