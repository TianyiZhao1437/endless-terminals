Bootstrap: localimage
From: ./ubuntu_22.04.sif

%post
    set -e

    # Create the applications directory
    mkdir -p /home/user/applications

    # Make it writable by the user (UID 1000 is default for user in Ubuntu images)
    chown 1000:1000 /home/user/applications
    chmod 775 /home/user/applications

    # Install Python3, pip, and pytest
    apt-get update
    apt-get install -y python3 python3-pip
    pip3 install --no-cache-dir pytest

    # Create a simple sample_app.py script
    cat <<EOF > /home/user/applications/sample_app.py
#!/usr/bin/env python3
import time
for _ in range(10):
    time.sleep(1)
EOF

    # Make sample_app.py executable
    chmod 755 /home/user/applications/sample_app.py
    chown 1000:1000 /home/user/applications/sample_app.py

%labels
    Author Example