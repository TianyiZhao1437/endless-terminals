Bootstrap: localimage
From: ./ubuntu_22.04.sif

%post
    set -eux

    # Install pip and pytest
    apt-get update
    apt-get install -y python3-pip
    pip3 install --no-cache-dir pytest

    # Create project directory
    mkdir -p /home/user/project

    # Create config.ini with the specified contents
    cat > /home/user/project/config.ini <<'EOF'
[general]
project_name = DataCleaner
version = 1.1

[paths]
main_script = scripts/process.py
data_dir = data/input
EOF

    # Ensure user ownership and correct permissions
    chown -R 1000:1000 /home/user
    chmod 755 /home/user
    chmod 755 /home/user/project
    chmod 644 /home/user/project/config.ini

%labels
    Author="Your Name"
    Description="Container for INI file extraction task with pytest installed."