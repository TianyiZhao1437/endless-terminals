Bootstrap: localimage
From: ./ubuntu_22.04.sif

%post
    set -eux

    # Create user and set up home directory
    useradd -m -s /bin/bash user

    # Ensure /home/user/artifacts exists and is writable
    mkdir -p /home/user/artifacts
    chown -R user:user /home/user

    # Install python3, pip, sqlite3, and pytest
    apt-get update
    apt-get install -y python3 python3-pip sqlite3
    pip3 install --no-cache-dir pytest

    # Clean apt cache
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%environment
    export PATH=/home/user/.local/bin:$PATH

%files

%labels
    Author mlops-experiment-tracker

%runscript
    exec /bin/bash