Bootstrap: localimage
From: ./ubuntu_22.04.sif

%post
    set -eux

    # Create the operator directory
    mkdir -p /home/user/operator

    # Set permissions to ensure agent (non-root) can access and modify files
    chown -R 1000:1000 /home/user/operator
    chmod 755 /home/user/operator

    # Create the VERSION file with initial contents
    echo "1.2.3" > /home/user/operator/VERSION
    chmod 644 /home/user/operator/VERSION
    chown 1000:1000 /home/user/operator/VERSION

    # Create the CHANGELOG.md file with initial contents
    cat > /home/user/operator/CHANGELOG.md <<EOF
## [1.2.3] - 2023-08-10

* Fixed deployment timeout issue

## [1.2.2] - 2023-07-15

* Improved reconciliation logic
EOF
    chmod 644 /home/user/operator/CHANGELOG.md
    chown 1000:1000 /home/user/operator/CHANGELOG.md

    # Ensure version_bump.log does NOT exist initially
    rm -f /home/user/operator/version_bump.log

    # Install pip and pytest
    apt-get update
    apt-get install -y python3-pip
    pip3 install --no-cache-dir pytest

%environment
    export PATH=/usr/local/bin:$PATH