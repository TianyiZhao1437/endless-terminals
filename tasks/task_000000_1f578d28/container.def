Bootstrap: localimage
From: ./ubuntu_22.04.sif

%post
    set -e

    # Create the user and home directories
    mkdir -p /home/user/cicd/logs
    mkdir -p /home/user/cicd/reports

    # Create the Jenkins pipeline log file with the required content
    cat > /home/user/cicd/logs/jenkins_pipeline.log <<'EOF'
Step: build | Started: 2024-06-05T10:01:44 | Ended: 2024-06-05T10:01:51 | Duration: 7
Step: test | Started: 2024-06-05T10:02:00 | Ended: 2024-06-05T10:02:01 | Duration: 1
Step: deploy | Started: 2024-06-05T10:02:30 | Ended: 2024-06-05T10:02:39 | Duration: 9
Step: post-cleanup | Started: 2024-06-05T10:03:01 | Ended: 2024-06-05T10:03:03 | Duration: 2
EOF

    # Ensure correct permissions so agent (likely running as user) can access
    chmod 755 /home/user
    chmod -R 755 /home/user/cicd
    chmod 755 /home/user/cicd/logs
    chmod 755 /home/user/cicd/reports
    chmod 644 /home/user/cicd/logs/jenkins_pipeline.log

    # Remove report file if exists (should NOT exist before agent runs)
    rm -f /home/user/cicd/reports/slow_steps_report.txt

    # Install pip and pytest
    apt-get update
    apt-get install -y python3-pip
    pip3 install --no-cache-dir pytest

%labels
    Author CI/CD Pipeline Setup