Bootstrap: localimage
From: ./ubuntu_22.04.sif

%post
    # Install Python3 and pip, then install pytest
    apt-get update
    apt-get install -y python3 python3-pip
    pip3 install pytest

    # Create required directories
    mkdir -p /home/user/project/data/containers

    # Create the required .sif files with correct names
    touch /home/user/project/data/containers/modelA_v1.sif
    touch /home/user/project/data/containers/data_preprocessor.sif
    touch /home/user/project/data/containers/modelB_v2.sif

    # Set permissions so non-root user can access/modify files and directories
    chmod -R 0777 /home/user/project

%files

%environment
    # No HOME override; Apptainer will bind the host $HOME