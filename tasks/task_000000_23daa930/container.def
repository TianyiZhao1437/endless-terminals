Bootstrap: localimage
From: ./ubuntu_22.04.sif

%post
    set -e
    # Create user home directory and set permissions
    mkdir -p /home/user
    chmod 755 /home/user

    # Create build_config.ini with required sections and keys
    cat > /home/user/build_config.ini <<EOF
[development]
build_version=4.1.0
api_url=https://dev.api.example.com

[production]
build_version=4.2.5
api_url=https://api.example.com
EOF

    chmod 644 /home/user/build_config.ini

    # Install Python3 and pip
    apt-get update
    apt-get install -y python3 python3-pip

    # Install pytest
    pip3 install pytest

%files

%environment
    export PATH=/usr/local/bin:/usr/bin:/bin:$PATH