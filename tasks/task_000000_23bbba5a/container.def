Bootstrap: localimage
From: ./ubuntu_22.04.sif

%post
    set -e

    # Install Python 3, pip, and SQLite3
    apt-get update
    apt-get install -y python3 python3-pip sqlite3

    # Install pytest
    pip3 install --no-cache-dir pytest

    # Create the deployment directory structure
    mkdir -p /home/user/deployment/db
    mkdir -p /home/user/deployment/logs

    # Set permissions: logs dir must be writable by the user (assume uid 1000)
    chmod 777 /home/user/deployment/logs

    # Create SQLite DB with 'users' then 'settings' tables in that order
    # (table creation order is preserved in sqlite_master)
    sqlite3 /home/user/deployment/db/app_release.db <<EOF
CREATE TABLE users (
    id INTEGER PRIMARY KEY,
    username TEXT NOT NULL
);
CREATE TABLE settings (
    id INTEGER PRIMARY KEY,
    setting_key TEXT NOT NULL,
    setting_value TEXT NOT NULL
);
EOF

    # Ensure permissions on the database file (readable and writable by user)
    chmod 666 /home/user/deployment/db/app_release.db

%labels
    Author="Deployment engineer setup for table listing task"
    Description="Prepares /home/user/deployment/db/app_release.db with 'users' and 'settings' tables, and a writable logs directory for Apptainer agent task."